# Copiar como app/.env y completar. Nunca subir app/.env al repositorio.

# Modelo generativo (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Supabase: Project URL y clave PUBLICABLE (sb_publishable_...). Nunca la secret/service_role.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# UUID (no secreto) del usuario de Auth que cargó el corpus en la Clase 08.
# Se obtiene con: select id from auth.users where email = '...';
CORPUS_PROPIETARIO_ID=

# Servidor web local: 127.0.0.1 y puerto 7860 por defecto.
GRADIO_SERVER_NAME=127.0.0.1
PORT=7860

# Opcionales (por defecto app/informes_generados y app/logs)
# INFORMES_DIR=
# LOGS_DIR=

# Opcional, solo en local (127.0.0.1): entra directo sin pantalla de login.
# Nunca configurarlas en un servidor público.
# AUTO_LOGIN_EMAIL=
# AUTO_LOGIN_PASSWORD=
